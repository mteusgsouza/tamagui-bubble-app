# Copie para `app.env` NA MÁQUINA. O arquivo preenchido nunca é versionado.
#
# Aqui vai só o que o servidor lê em RUNTIME. As variáveis `VITE_*` não entram: elas
# são embutidas no build, na sua máquina — ver o README.

# ---------------------------------------------------------------------------
# Identidade e sessão
# ---------------------------------------------------------------------------
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="..."
BETTER_AUTH_URL="https://bubble.mateusgsouza.com.br"
ONE_SERVER_URL="https://bubble.mateusgsouza.com.br"

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# O Postgres. Roda no container `db`, na mesma máquina — ver o docker-compose.
#
# ⚠️ **Sem `sslmode=require`**: `createPool` liga TLS quando a string contém isso, e o
# container não tem certificado. Com o parâmetro, a conexão falha.
DATABASE_URL="postgresql://bubble:SENHA@db:5432/bubble"
POSTGRES_PASSWORD="a mesma senha de cima"

# tem que casar com a imagem do zero-cache no docker-compose.yml

# ---------------------------------------------------------------------------
# Mídia — Cloudflare R2
# ---------------------------------------------------------------------------
# Vazias, as rotas de mídia respondem 503 e o resto do app funciona.
# ⚠️ O CORS do bucket precisa listar https://bubble.mateusgsouza.com.br: o navegador
# faz PUT direto no R2, sem passar por este servidor.
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ACCESS_KEY=""
CLOUDFLARE_R2_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Login com Google
# ---------------------------------------------------------------------------
# No Google Cloud Console, a URI de redirecionamento autorizada tem que ser
# exatamente https://bubble.mateusgsouza.com.br/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Cobrança e cron
# ---------------------------------------------------------------------------
BILLING_PROVIDER="manual"
BILLING_WEBHOOK_SECRET=""

# protege /api/cron/expire-subscriptions e o modo diagnóstico de /api/health
CRON_SECRET=""
