# Copie para `app.env` NA MÁQUINA. O arquivo preenchido nunca é versionado.
#
# Aqui vai só o que o servidor lê em RUNTIME. As variáveis `VITE_*` não entram: elas
# são embutidas no build, na sua máquina — ver o README.

# ---------------------------------------------------------------------------
# Identidade e sessão
# ---------------------------------------------------------------------------
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="..."
BETTER_AUTH_URL="https://bubble.mateusgsouza.com.br"
ONE_SERVER_URL="https://bubble.mateusgsouza.com.br"

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# 🔴 As DUAS com o mesmo valor. Parece redundante e não é: `src/zero/server.ts` lê
# `process.env` direto, sem passar pelo `env-server.ts`, então o fallback de lá não o
# alcança. Faltando a segunda, `/api/zero/pull` e `/api/zero/push` respondem 404 (não
# 500) — o One não registra rota cujo módulo não carrega.
#
# Aqui pode ser a MESMA direta que o zero-cache usa: este é um container único e
# duradouro, com pool próprio. O pooler só fazia falta em serverless, onde cada função
# abria conexão nova.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
ZERO_UPSTREAM_DB="postgresql://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# tem que casar com a imagem do zero-cache no docker-compose.yml
ZERO_VERSION="0.26.2"
ZERO_APP_PUBLICATIONS="zero_takeout"

# ---------------------------------------------------------------------------
# Mídia — Cloudflare R2
# ---------------------------------------------------------------------------
# Vazias, as rotas de mídia respondem 503 e o resto do app funciona.
# ⚠️ O CORS do bucket precisa listar https://bubble.mateusgsouza.com.br: o navegador
# faz PUT direto no R2, sem passar por este servidor.
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ACCESS_KEY=""
CLOUDFLARE_R2_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Login com Google
# ---------------------------------------------------------------------------
# No Google Cloud Console, a URI de redirecionamento autorizada tem que ser
# exatamente https://bubble.mateusgsouza.com.br/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Cobrança e cron
# ---------------------------------------------------------------------------
BILLING_PROVIDER="manual"
BILLING_WEBHOOK_SECRET=""

# protege /api/cron/expire-subscriptions e o modo diagnóstico de /api/health
CRON_SECRET=""
