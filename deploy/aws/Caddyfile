# Um bloco por subdomínio. O Caddy emite e renova os certificados sozinho; o único
# requisito é que os dois nomes já resolvam para esta máquina antes de subir.

bubble.mateusgsouza.com.br {
	reverse_proxy app:8092
}

zero.mateusgsouza.com.br {
	# WebSocket é o transporte do sync — o Caddy repassa upgrade sem configuração extra
	reverse_proxy zero:4848
}
