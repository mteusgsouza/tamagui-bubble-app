# Copie para `zero.env` NA MÁQUINA. O arquivo preenchido nunca é versionado.

# ---------------------------------------------------------------------------
# Banco — Neon
# ---------------------------------------------------------------------------
# 🔴 As três SEM `-pooler` no host. O pooler do Neon é PgBouncer em modo transação e
# não suporta replicação lógica; o zero-cache falha de um jeito que parece permissão.
#
# São a MESMA string, mudando só o nome do banco entre a `/` e o `?`.
# Pegue a "Direct connection" no painel do Neon.
ZERO_UPSTREAM_DB="postgresql://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
ZERO_CVR_DB="postgresql://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/zero_cvr?sslmode=require"
ZERO_CHANGE_DB="postgresql://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/zero_cdb?sslmode=require"

# ---------------------------------------------------------------------------
# Operação
# ---------------------------------------------------------------------------
# senha do painel administrativo do próprio zero-cache
ZERO_ADMIN_PASSWORD="troque-por-uma-senha-forte"

# `debug` ajuda no primeiro boot, quando ele monta o replica
ZERO_LOG_LEVEL="info"
