# ============================================================================
# .env.development — configuração de DESENVOLVIMENTO. É versionado.
# ============================================================================
#
# 🔴 Segredo de verdade NÃO entra aqui: este arquivo vai para o GitHub. Chave real
# (R2, Google, gateway de pagamento) vive em `.env.local`, que é gitignored — o mapa
# está em `.env.local.example`.
#
# ┌─ Qual arquivo usar para quê ──────────────────────────────────────────────┐
# │ .env              igual em toda máquina e produção (gerado, não versionado)│
# │ .env.development  aqui: URLs locais, bancos locais, ids, flags de dev      │
# │ .env.local        segredo real desta máquina                              │
# └───────────────────────────────────────────────────────────────────────────┘
#
# 🔴 **Uma variável mora em UM arquivo só** — os três carregadores discordam da ordem
# (detalhes em `.env.local.example`), então chave repetida resolve diferente conforme o
# comando. Por isso `ZERO_*_FORWARD_COOKIES` está só no `.env`, e não aqui.

# --- auth ---
# Segredo de assinatura de sessão. Este valor é de desenvolvimento e serve só para o
# banco local; em produção vem do `.env.production`.
BETTER_AUTH_SECRET=asjdbafbiasdjsadjasahjYVGHSVHFB
BETTER_AUTH_URL="http://localhost:8081"

# --- servidor ---
ONE_SERVER_URL="http://localhost:8081"
# ONE_SUSPEND_ROUTES=1
# ⚠️ DESLIGADO de propósito. Isso envolve cada rota num <Suspense> na web, e o próprio
# One deixa isso off por padrão lá: "suspense causes flickers on web during nav since
# react navigation doesn't properly respect startTransition"
# (node_modules/one/src/router/useScreens.tsx). Com ele ligado, TODO carregamento direto
# de URL resetava o roteador para `/` (~200ms depois do boot), caía no
# `<Redirect href="/auth/login">` do app/index+ssg.tsx e terminava em /home/feed —
# quebrando qualquer deep link, inclusive compartilhar link de post.

# --- app ---
VITE_DEMO_MODE=1

# id do usuário mestre (dono do feed e dos cursos). Vazio = feed vazio, e isso é o
# comportamento correto, não bug.
# Como descobrir o id: veja o handoff da Fase 4 (docs/build-log/handoffs/).
VITE_MASTER_USER_ID="demo-user-id"
VITE_ZERO_HOSTNAME=""
VITE_WEB_HOSTNAME=""

# --- Zero (bancos e rotas locais) ---
ZERO_UPSTREAM_DB="postgresql://user:password@127.0.0.1:5533/postgres"
ZERO_CVR_DB="postgresql://user:password@127.0.0.1:5533/zero_cvr"
ZERO_CHANGE_DB="postgresql://user:password@127.0.0.1:5533/zero_cdb"
ZERO_MUTATE_URL="http://localhost:8081/api/zero/push"
ZERO_QUERY_URL="http://localhost:8081/api/zero/pull"
ZERO_REPLICA_FILE="/tmp/onechat_replica.db"

# --- e-mail ---
# Token de sandbox do próprio template Takeout, veio no primeiro commit — não é
# credencial sua e não há o que revogar. Usado só por `scripts/helpers/*`.
POSTMARK_SERVER_TOKEN=581c19e3-ad63-402a-bafa-919a8e0342d3

# --- cobrança (Fase 9) ---
# Valores de desenvolvimento; em produção vêm do painel do gateway. `BILLING_PROVIDER`
# fica no `.env` porque vale igual em toda máquina enquanto for "manual".
BILLING_WEBHOOK_SECRET="dev-webhook-secret-nao-usar-em-producao"
CRON_SECRET="dev-cron-secret-nao-usar-em-producao"

# --- o que NÃO fica aqui ---
# CLOUDFLARE_R2_*, GOOGLE_CLIENT_*, EXTRA_TRUSTED_ORIGINS → `.env.local` (segredo real
# ou específico da máquina). Ver `.env.local.example`.
